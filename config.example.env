# Copie vers .env et adapte. .env est git-ignoré.

# --- OpenAI (génération de la voix, backend par défaut) ---
OPENAI_API_KEY=sk-...
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=shimmer
TTS_INSTRUCTIONS="Voix féminine française, posée et légèrement espiègle, ton de majordome dévoué avec une pointe d'ironie. Débit calme, articulation nette."

# --- Piper (backend local, voix entraînée) ---
# Renseigne ces variables puis utilise --backend piper.
# Voir docs/TRAINING.md pour entraîner ta voix, ou scripts/00-fetch-glados-fr.sh
# pour télécharger la voix GLaDOS-FR pré-entraînée.
PIPER_MODEL=                # ex: dist/fr_FR-glados_fr-medium.onnx
PIPER_CONFIG=               # ex: dist/fr_FR-glados_fr-medium.onnx.json
PIPER_BIN=piper             # binaire piper (venv OK)

# --- Home Assistant ---
HA_URL=http://192.168.1.10:8123
HA_TOKEN=                      # jeton d'accès longue durée (Profil -> Sécurité)
VACUUM_ENTITY=vacuum.my_robot

# --- Hébergement du pack ---
# IP de la machine qui sert le fichier, joignable par le ROBOT sur le LAN.
HTTP_HOST=192.168.1.10
HTTP_PORT=8099

# Identifiant du pack. Toute valeur non standard convient (T2, T3...).
LANG_ID=T2
